---
import { cn, generateId } from '@refraction-ui/shared'
import {
  assertValidDatePresets,
  datePickerPresetStyles,
  datePickerPresetsStyles,
  datePickerTriggerStyles,
  formatDate,
  DEFAULT_DATE_PRESETS_LABEL,
  type DatePreset,
} from '@refraction-ui/date-picker'

interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Selected date value (ISO string) */
  value?: string
  /** Minimum selectable date (ISO string) */
  minDate?: string
  /** Maximum selectable date (ISO string) */
  maxDate?: string
  /** Show time selection inputs */
  showTime?: boolean
  /** Display format for the selected-date text shown next to the input (e.g. 'DD/MM/YYYY'). The native input value itself stays ISO (`YYYY-MM-DD`). */
  format?: string
  /** Placeholder text */
  placeholder?: string
  /** Whether the picker is disabled */
  disabled?: boolean
  /**
   * One-click dates shown under the input, in order: `createDefaultDatePresets()`
   * gives "Today", "Tomorrow" and "Next week", and callers can add their own.
   * Labels are shown as given, so pass them already translated. The browser
   * resolves each one against the reader's date when the page loads and again
   * when it is chosen, so a statically built page stays correct.
   */
  presets?: readonly DatePreset[]
  /** Accessible name of the group of presets (default: "Date shortcuts"). */
  presetsLabel?: string
}

const {
  value,
  minDate,
  maxDate,
  showTime = false,
  format,
  placeholder,
  disabled = false,
  presets = [],
  presetsLabel = DEFAULT_DATE_PRESETS_LABEL,
  id,
  class: className,
  ...props
} = Astro.props

// Reject a bad preset list when the page renders, not in the reader's browser.
assertValidDatePresets(presets)
// Presets point at the input they fill, so it needs an id.
const inputId = id ?? (presets.length > 0 ? generateId('rfr-datepicker') : undefined)

const sliceLen = showTime ? 16 : 10

// Format to YYYY-MM-DD or YYYY-MM-DDTHH:mm
function formatDateStr(isoStr?: string) {
  if (!isoStr) return undefined
  try {
    const d = new Date(isoStr)
    const offset = d.getTimezoneOffset() * 60000
    const localDate = new Date(d.getTime() - offset)
    return localDate.toISOString().slice(0, sliceLen)
  } catch (e) {
    return undefined
  }
}

const parsedValue = formatDateStr(value)
const parsedMin = formatDateStr(minDate)
const parsedMax = formatDateStr(maxDate)

// A custom display format cannot be honored by the native input itself (the
// browser locale controls its presentation), so the formatted date renders as
// adjacent text via the core's formatter — mirroring the React adapter.
const formattedDisplay = format && value ? formatDate(new Date(value), format, showTime) : undefined
---

<input
  id={inputId}
  type={showTime ? "datetime-local" : "date"}
  class={cn(datePickerTriggerStyles, "justify-start text-left font-normal w-[280px]", className)}
  value={parsedValue}
  min={parsedMin}
  max={parsedMax}
  disabled={disabled}
  placeholder={placeholder}
  data-rfr-datepicker
  {...props}
/>
{formattedDisplay && (
  <span class="text-sm text-muted-foreground">{formattedDisplay}</span>
)}
{presets.length > 0 && (
  <div role="group" aria-label={presetsLabel} class={datePickerPresetsStyles} data-rfr-datepicker-presets>
    {presets.map((preset) => (
      <button
        type="button"
        class={datePickerPresetStyles}
        data-rfr-datepicker-preset={preset.id}
        data-rfr-datepicker-preset-days={preset.days}
        data-rfr-datepicker-preset-weekday={preset.weekday}
        aria-controls={inputId}
        disabled={disabled}
      >
        {preset.label}
      </button>
    ))}
  </div>
)}

<script>
  import { initDatePickers } from './date-picker-client.js'

  initDatePickers()
  document.addEventListener('astro:after-swap', () => initDatePickers())
</script>
