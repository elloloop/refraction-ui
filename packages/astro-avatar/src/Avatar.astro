---
import { createAvatar, avatarVariants, type AvatarSize, type AvatarShape } from '@refraction-ui/avatar'
import { cn } from '@refraction-ui/shared'

interface Props extends astroHTML.JSX.HTMLAttributes {
  size?: AvatarSize
  shape?: AvatarShape
}

const { size = 'md', shape = 'circle', class: className, ...props } = Astro.props
const api = createAvatar({ size, alt: props['aria-label'] as string | undefined })
---

<span
  class={cn(avatarVariants({ size, shape }), className)}
  data-rfr-avatar
  data-rfr-avatar-size={size}
  {...api.ariaProps}
  {...api.dataAttributes}
  {...props}
>
  <slot />
</span>
