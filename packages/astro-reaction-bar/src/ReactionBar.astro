---
import {
  createReactionBar,
  reactionBarStyles,
  reactionPillVariants,
  reactionAddButtonStyles,
  reactionOverflowButtonStyles,
  reactionChipStyles,
  reactionTooltipStyles,
  reactionTooltipContentStyles,
  reactionEmojiStyles,
  reactionCountStyles,
  type Reaction,
  type ReactionBarStrings,
} from '@refraction-ui/reaction-bar'
import { cn } from '@refraction-ui/shared'

interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Array of reactions to display */
  reactions: Reaction[]
  /**
   * Whether to show the add reaction button. Default: true. Pressing it
   * dispatches `rfr-reaction-add` with the button as `detail.trigger`, for
   * anchoring an emoji picker.
   */
  showAddButton?: boolean
  /** Reactions shown before a "+N" button that expands the bar. */
  maxVisible?: number
  /** Overrides for the user-facing strings (English defaults). */
  strings?: Partial<ReactionBarStrings>
}

const {
  reactions = [],
  showAddButton = true,
  maxVisible,
  strings,
  class: className,
  ...props
} = Astro.props

const api = createReactionBar({ reactions, maxVisible, strings })
// The same bar expanded, for the overflow button's "Show less" state.
const expanded = createReactionBar({
  reactions,
  maxVisible,
  strings,
  expanded: true,
  idPrefix: api.ids.container,
})
const initiallyVisible = new Set(api.visibleReactions)

/**
 * A pill's count, name and look once toggled on or off. The client script
 * swaps between the two, so a toggle never re-derives text in the browser.
 */
function pillState(reaction: Reaction, on: boolean) {
  const delta = on === reaction.userReacted ? 0 : on ? 1 : -1
  const count = Math.max(0, reaction.count + delta)
  return {
    count,
    label: String(api.getReactionAriaProps({ ...reaction, count, userReacted: on })['aria-label']),
    className: reactionPillVariants({ state: on ? 'active' : 'inactive' }),
  }
}
---

<div
  data-rfr-reaction-bar
  data-rfr-rb-reactions={JSON.stringify(reactions)}
  class={cn(reactionBarStyles, className)}
  {...api.ariaProps}
  {...props}
>
  {reactions.map((reaction) => {
    const tooltip = api.getReactorsTooltip(reaction)
    const on = pillState(reaction, true)
    const off = pillState(reaction, false)
    const pill = (
      <button
        type="button"
        data-rfr-rb-emoji={reaction.emoji}
        data-rfr-rb-count-on={on.count}
        data-rfr-rb-count-off={off.count}
        data-rfr-rb-label-on={on.label}
        data-rfr-rb-label-off={off.label}
        data-rfr-rb-class-on={on.className}
        data-rfr-rb-class-off={off.className}
        class={reactionPillVariants({ state: reaction.userReacted ? 'active' : 'inactive' })}
        {...api.getReactionAriaProps(reaction)}
      >
        <span class={reactionEmojiStyles}>{reaction.emoji}</span>
        <span class={reactionCountStyles} data-rfr-rb-count>{reaction.count}</span>
      </button>
    )
    const chip = tooltip ? (
      <span class={reactionChipStyles} data-rfr-rb-chip>
        {pill}
        <span id={tooltip.id} role={tooltip.role} class={reactionTooltipStyles} hidden>
          <span class={reactionTooltipContentStyles}>{tooltip.text}</span>
        </span>
      </span>
    ) : pill
    // A reaction past `maxVisible` waits in an unstyled wrapper, so `hidden`
    // hides it whether or not the page ships Tailwind's preflight.
    return initiallyVisible.has(reaction) ? chip : (
      <span data-rfr-rb-overflow-item hidden>{chip}</span>
    )
  })}
  {api.overflowButtonAriaProps && expanded.overflowButtonAriaProps && (
    <button
      type="button"
      data-rfr-rb-overflow
      data-rfr-rb-more-text={api.overflowButtonText}
      data-rfr-rb-more-label={api.overflowButtonAriaProps['aria-label']}
      data-rfr-rb-less-text={expanded.overflowButtonText}
      data-rfr-rb-less-label={expanded.overflowButtonAriaProps['aria-label']}
      class={reactionOverflowButtonStyles}
      {...api.overflowButtonAriaProps}
    >
      {api.overflowButtonText}
    </button>
  )}
  {showAddButton && (
    <button
      type="button"
      data-rfr-rb-add
      class={reactionAddButtonStyles}
      {...api.addButtonAriaProps}
    >
      +
    </button>
  )}
</div>

<script>
  import { initReactionBars } from './reaction-bar-client.js'

  initReactionBars(document)
  document.addEventListener('astro:after-swap', () => initReactionBars(document))
</script>
