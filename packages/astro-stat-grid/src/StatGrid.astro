---
import {
  createStatGrid,
  statColumns,
  statColumnsKey,
  statGridVariants,
  statItemVariants,
  statValueVariants,
  statLabelVariants,
  statDescriptionClass,
  type StatItem,
  type StatGridVariant,
  type StatGridLayout,
  type StatGridColumns,
} from '@refraction-ui/stat-grid'
import { cn } from '@refraction-ui/shared'

interface Props extends astroHTML.JSX.HTMLAttributes {
  /** The stat items to display in the grid. */
  items: StatItem[]
  /** Maximum columns (reflows on narrow screens) or `auto`. Defaults to statColumns(items.length). */
  columns?: StatGridColumns
  variant?: StatGridVariant
  layout?: StatGridLayout
}

const { items, columns, variant = 'plain', layout = 'value-first', class: className, ...rest } = Astro.props
const cols = statColumnsKey(columns ?? statColumns(items.length))
const { ariaProps, dataAttributes } = createStatGrid()
---

<div
  class={cn(statGridVariants({ columns: cols, variant }), className)}
  data-variant={variant}
  data-layout={layout}
  {...ariaProps}
  {...dataAttributes}
  {...rest}
>
  {
    items.map((item) => (
      <div role="listitem" class={statItemVariants({ variant })} data-tone={item.tone ?? 'default'}>
        {layout === 'label-first' && <span class={statLabelVariants({ layout })}>{item.label}</span>}
        <span class={statValueVariants({ variant, tone: item.tone ?? 'default' })}>{item.value}</span>
        {layout === 'value-first' && <span class={statLabelVariants({ layout })}>{item.label}</span>}
        {item.description && <span class={statDescriptionClass}>{item.description}</span>}
      </div>
    ))
  }
</div>
