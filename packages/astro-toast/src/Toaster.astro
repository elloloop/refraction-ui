---
import {
  toastAnnouncerClass,
  toasterClass,
  DEFAULT_TOAST_DISMISS_LABEL,
  DEFAULT_TOASTER_LABEL,
} from '@refraction-ui/toast'
import { cn } from '@refraction-ui/shared'

interface Props extends astroHTML.JSX.HTMLAttributes {
  /** Accessible name of the dismiss button on toasts shown with `window.__rfr_toast` (default: "Dismiss"). */
  dismissLabel?: string
}

const {
  class: className,
  'aria-label': label = DEFAULT_TOASTER_LABEL,
  dismissLabel = DEFAULT_TOAST_DISMISS_LABEL,
  ...props
} = Astro.props

// A labelled landmark ("Notifications" unless aria-label says otherwise) with
// a polite and an assertive live region that exist before any toast, which is
// what makes screen readers announce reliably. Errors interrupt; everything
// else waits its turn.
---

<div
  data-rfr-toaster
  role="region"
  aria-label={label}
  data-rfr-toast-dismiss-label={dismissLabel}
  class={cn(toasterClass, className)}
  {...props}
>
  <div
    class={toastAnnouncerClass}
    aria-live="polite"
    aria-atomic="false"
    aria-relevant="additions"
    data-rfr-toast-announcer="polite"
  ></div>
  <div
    class={toastAnnouncerClass}
    aria-live="assertive"
    aria-atomic="false"
    aria-relevant="additions"
    data-rfr-toast-announcer="assertive"
  ></div>
  <slot />
</div>

<script>
  import { installToaster } from './toaster-client.js'

  installToaster()
</script>
